{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Journey Test Specification",
  "type": "object",
  "required": ["id", "name", "area", "status", "steps", "assertions"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^J[0-9]{3,}$" },
    "name": { "type": "string", "minLength": 1 },
    "area": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]*$"
    },
    "status": { "type": "string", "enum": ["approved", "retired"] },
    "version": { "type": "integer", "minimum": 1, "default": 1 },
    "priority": { "type": "string", "enum": ["CRITICAL", "HIGH", "MEDIUM", "LOW"], "default": "MEDIUM" },
    "tags": { "type": "array", "items": { "type": "string" } },
    "preconditions": { "type": "array", "items": { "type": "string" } },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["action"],
        "additionalProperties": false,
        "properties": {
          "action": {
            "type": "string",
            "enum": ["navigate", "click", "fill", "select", "check", "press", "back", "reload", "wait_for", "assert"]
          },
          "target": { "type": "string" },
          "value": { "type": "string" },
          "condition": { "type": "string" }
        }
      }
    },
    "assertions": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "checkpoints": { "type": "array", "items": { "type": "string" } },
    "edge_cases": { "type": "array", "items": { "type": "string" } },
    "dynamic_values": { "type": "array", "items": { "type": "string" } },
    "provenance": {
      "type": "object",
      "properties": {
        "generated_by": { "type": "string" },
        "generated_at": { "type": "string" },
        "source_flow_id": { "type": "string" },
        "retired_at": { "type": ["string", "null"] },
        "retirement_reason": { "type": "string" }
      }
    }
  }
}
